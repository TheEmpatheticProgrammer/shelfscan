# Which LLM to use: "anthropic" (Claude API) or "openai" (any OpenAI-compatible server, e.g. your LLM gateway)
LLM_PROVIDER=openai

# --- OpenAI-compatible server (LLM gateway, vLLM, Ollama, LM Studio, llama.cpp) ---
# Base URL up to and including /v1; the app calls <LLM_BASE_URL>/chat/completions
# (D:\llm-gateway listens on port 8000, so run ShelfScan itself on 8001)
LLM_BASE_URL=http://localhost:8000/v1
# Model (or gateway alias) that reads photos. Must route to a vision model, e.g. Qwen2.5-VL / Qwen3-VL.
LLM_MODEL=books-vision
# Model (or gateway alias) for recommendations; defaults to LLM_MODEL
LLM_TEXT_MODEL=books-recommend
# Sent as the x-client-id header so the gateway's usage logs show ShelfScan traffic
LLM_CLIENT_ID=shelfscan
# How many photos are sent to the model at once (each photo is its own request)
LLM_CONCURRENCY=2
# Leave empty if the gateway needs no key
LLM_API_KEY=
# Seconds to wait for a reply; keep below the app's 300 s timeout
LLM_TIMEOUT=240
# Photos are shrunk to this long edge before going to the model (smaller = faster; 0 = no resize)
LLM_MAX_IMAGE_EDGE=1024
# Cap on reply length
LLM_MAX_TOKENS=2048
# Extra JSON added to every request. For Qwen3 models, this turns off slow "thinking" output:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=

# --- Anthropic (only when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# Optional: raise Google Books quota (https://console.cloud.google.com → Books API)
GOOGLE_BOOKS_API_KEY=
# Optional: shared secret; set the same value as shelfscan.appToken in android/gradle.properties
APP_TOKEN=

# Covers and book descriptions also come from Open Library (no key needed). Set to 0 to use Google Books only.
SHELFSCAN_OPEN_LIBRARY=1
